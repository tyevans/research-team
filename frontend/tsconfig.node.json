{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"]
  },
  // The build tooling, and the tests that check the build tooling. They read
  // config files off disk, so they need `node` types that application code
  // deliberately cannot see.
  "include": ["vite.config.ts", "scripts/**/*.ts"]
}
