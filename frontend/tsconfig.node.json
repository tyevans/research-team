{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"]
  },
  // The build tooling, and the tests that check the build tooling. They read
  // config files off disk, so they need `node` types that application code
  // deliberately cannot see.
  //
  // `.storybook` used to be here on the theory that a config file is Node's.
  // It moved to `tsconfig.json` when `preview.tsx` gained a decorator: a
  // decorator is a component, `OverlayHost` is DOM code, and this config has
  // no `DOM` lib — so the workbench's own configuration stopped compiling
  // here and belonged with the browser code it actually is. `npm run
  // typecheck` still covers it, which is still the reason `storybook build`
  // is absent from `npm run verify`; only the config it is covered by changed.
  "include": ["vite.config.ts", "scripts/**/*.ts"]
}
