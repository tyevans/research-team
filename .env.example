# Template for local configuration. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# Nothing in the application reads this file. `research_team/infrastructure/
# config.py` reads the *environment*, and that is the only module that does.
# The loading is uv's job:
#
#     uv run --env-file .env web.py
#
# or, so plain `uv run` picks it up every time:
#
#     export UV_ENV_FILE=.env
#
# Every value below is optional. An unset variable means the documented
# default, and for the two capability variables it means the capability is
# absent rather than disabled -- no search tool is registered without a
# SearXNG instance, and no knowledge tools without a project.

# --- the model -------------------------------------------------------------

# An OpenAI-compatible endpoint. The default assumes a server on this machine.
# AGENT_BASE_URL=http://localhost:8080/v1/
# AGENT_MODEL=qwen3.6-27b-mtp
# AGENT_API_KEY=not-needed

# --- web search ------------------------------------------------------------

# A SearXNG instance. Unset means no `web_search` tool is registered at all,
# which is what keeps "nothing leaves the process" true for a default install.
# No trailing slash: the tool appends `/search`.
#
# The instance must serve JSON, which SearXNG does NOT do by default -- add
# `json` to `search.formats` in its settings.yml. A `limiter: true` instance
# may also reject non-browser clients with a 403.
# AGENT_SEARXNG_URL=http://192.168.1.14:8091
# AGENT_SEARXNG_RESULTS=5

# --- the knowledge graph ---------------------------------------------------

# What backs a project's graph. `memory` needs no server and rebuilds by
# folding the log when a project is opened; `neo4j` persists.
# AGENT_GRAPH_STORE=memory

# A redstring schema id, or `auto` to have a classifier choose. `auto` never
# fails -- it falls back to `encyclopedia_wiki` -- so read the confidence in
# `remember`'s output rather than trusting the schema name alone.
# AGENT_KNOWLEDGE_DOMAIN=auto

# Only read when AGENT_GRAPH_STORE=neo4j. There is deliberately no default
# password: a graph store that silently comes up on neo4j/neo4j either fails
# confusingly or connects to somebody else's development server.
# AGENT_NEO4J_URI=bolt://localhost:7687
# AGENT_NEO4J_USER=neo4j
# AGENT_NEO4J_PASSWORD=
# AGENT_NEO4J_DATABASE=

# --- storage and context ---------------------------------------------------

# Where sessions live. Defaults to ~/.research-team/sessions.db.
# AGENT_DB=

# How a conversation that outgrows the window is handled:
# full | elide | compact | delegate
# AGENT_CONTEXT_MODE=full

# --- web front end ---------------------------------------------------------

# AGENT_WEB_HOST=127.0.0.1
# AGENT_WEB_PORT=8000

# --- tracing ---------------------------------------------------------------

# Off unless installed with the `tracing` extra and switched on here.
# AGENT_TRACING=
# AGENT_OTLP_ENDPOINT=http://localhost:4318/v1/traces
